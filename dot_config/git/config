[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	rebase = false

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default

[core]
	excludesfile = ~/.config/git/ignore

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	line-numbers = true
	navigate = true
